SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8088
DB_HOST=db.internal.example.com
DB_PORT=5432
DB_NAME=changebook
DB_USERNAME=changebook_app
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_EXPIRATION_MS=86400000
PROFILE_UPLOAD_DIR=/var/lib/changebook/profiles
CORS_ALLOWED_ORIGIN_PATTERNS=https://web.example.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=20
PASSWORD_RESET_MAX_REQUESTS_PER_EMAIL=3
PASSWORD_RESET_MAX_REQUESTS_PER_IP=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=60
PASSWORD_RESET_URL=https://web.example.com/reset-password
PASSWORD_RESET_MAIL_ENABLED=true
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=no-reply@example.com
